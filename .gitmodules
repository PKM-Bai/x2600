[submodule "libbare-cpu"]
	path = libbare-cpu
	url = https://gitee.com/ingenic-dev/libbare-cpu.git
[submodule "third_party/ReGBA"]
	path = third_party/ReGBA
	url = https://github.com/Nebuleon/ReGBA.git
[submodule "u-boot-ingenic"]
	path = u-boot-ingenic
	url = http://git1.ingenic.com.cn:8082/gerrit/bootloader/u-boot
	# build-uboot.sh applies the two versioned patches to this optional tree.
	ignore = dirty
[submodule "third_party/mGBA"]
	path = third_party/mGBA
	url = https://github.com/mgba-emu/mgba.git
