set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR mips)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# CROSS_COMPILE is the full path and prefix, ending in '-'.
if(NOT CROSS_COMPILE)
    message(FATAL_ERROR "Pass -DCROSS_COMPILE=/path/to/bin/mips-...-")
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CROSS_COMPILE)
if(CMAKE_HOST_WIN32)
    set(_exe .exe)
else()
    set(_exe "")
endif()
set(CMAKE_C_COMPILER "${CROSS_COMPILE}gcc${_exe}")
set(CMAKE_CXX_COMPILER "${CROSS_COMPILE}g++${_exe}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_OBJCOPY "${CROSS_COMPILE}objcopy${_exe}")
set(CMAKE_SIZE "${CROSS_COMPILE}size${_exe}")
set(CMAKE_EXECUTABLE_SUFFIX_ASM .elf)
set(CMAKE_EXECUTABLE_SUFFIX_C .elf)
set(CMAKE_EXECUTABLE_SUFFIX_CXX .elf)
