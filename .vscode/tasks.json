{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "X2600M: build Windows",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "X2600M: build WSL",
      "type": "process",
      "command": "wsl.exe",
      "args": ["-d", "Ubuntu-22.04", "--", "bash", "scripts/build.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "X2600M: build U-Boot WSL",
      "type": "process",
      "command": "wsl.exe",
      "args": ["-d", "Ubuntu-22.04", "--", "bash", "scripts/build-uboot.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ]
}
